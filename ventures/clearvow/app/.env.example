# Required
DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# Stripe (optional locally; billing pages show "not configured" without these)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_UNLOCK=""

# Email (optional; logs to console without it)
RESEND_API_KEY=""
EMAIL_FROM="Clearvow <hello@example.com>"

# SMS verification (optional; codes are logged to the server console without it)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SID=""

# AI (optional; deterministic drafting without it)
ANTHROPIC_API_KEY=""
AI_DAILY_BUDGET_USD="5"

# Cron endpoints
CRON_SECRET="change-me"
